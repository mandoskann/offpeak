# Copy this file to .env and fill in your own values. Never commit .env.

# Server
OFFPEAK_HOST=127.0.0.1
OFFPEAK_PORT=8000

# Set to 1 to use built-in sample prices instead of the live ComEd API
OFFPEAK_OFFLINE=0

# Agent (Amazon Bedrock). Log in first with: aws login
AWS_REGION=us-east-1
# Any Claude model you have Bedrock access to (Bedrock console -> Model catalog)
OFFPEAK_MODEL_ID=global.anthropic.claude-sonnet-4-6
OFFPEAK_URL=http://127.0.0.1:8000/mcp

# OR use the Anthropic API instead of Bedrock: uncomment and paste your key
# ANTHROPIC_API_KEY=
# OFFPEAK_PROVIDER=anthropic

# Web app (simulated Alexa+)
OFFPEAK_WEB_PORT=8080
# How often the autopilot checks for price spikes (seconds)
OFFPEAK_WATCH_SECONDS=60
